# STB Webhook Enricher Configuration
# Copy this file to .env and fill in your actual values

# Server Configuration
PORT=3000

# Security
SECRET_TOKEN=change-me-to-a-random-secure-string

# Data API Keys
IEX_TOKEN=your_iex_cloud_token_here
CHEDDAR_TOKEN=your_cheddarflow_token_here
FINTEL_KEY=your_fintel_api_key_here

# Notification Webhooks
DISCORD_WEBHOOK=https://discord.com/api/webhooks/your_webhook_url
SLACK_WEBHOOK=https://hooks.slack.com/services/your_webhook_url

# Email (optional - if using SendGrid)
SENDGRID_API_KEY=your_sendgrid_api_key_here
RECIPIENT_EMAIL=your_email@example.com
SENDER_EMAIL=alerts@yourdomain.com

# Trade Execution (optional)
ALPACA_API_KEY=your_alpaca_api_key_here
ALPACA_SECRET_KEY=your_alpaca_secret_key_here
ALPACA_BASE_URL=https://paper-api.alpaca.markets

# Advanced Options
CACHE_TTL=86400
MAX_CONCURRENT_TRADES=3
ENABLE_AUTO_EXECUTE=false

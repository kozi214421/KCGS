# STB Toolkit Environment Variables Example
# Copy this file to .env and fill in your actual values

# Server Configuration
PORT=5000
DEBUG=false
LOG_LEVEL=info

# Data Provider API Keys
FINRA_API_KEY=your_finra_api_key_here
UNUSUAL_WHALES_API_KEY=your_unusual_whales_api_key_here
QUIVER_API_KEY=your_quiver_quant_api_key_here

# Notification Services
DISCORD_WEBHOOK_URL=your_discord_webhook_url_here
SLACK_WEBHOOK_URL=your_slack_webhook_url_here
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# Email Configuration (Optional)
EMAIL_FROM=alerts@yourdomain.com
EMAIL_PASSWORD=your_email_password_here
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587

# Caching (Optional - Redis)
REDIS_URL=redis://localhost:6379/0

# Database (Optional)
DATABASE_URL=sqlite:///stb_alerts.db

# Security
WEBHOOK_SECRET_KEY=your_secret_key_for_authentication_here
API_RATE_LIMIT=100
